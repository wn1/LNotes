<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- the theme applied to the application or activity -->
    <style name="QDVActivityTheme" parent="QDVActivityThemeDef">
        <item name="android:actionBarStyle">@style/QDVActivityThemeDef</item>
        <item name="android:colorAccent" tools:targetApi="lollipop">@color/appAccentColor</item>
        <item name="android:colorControlActivated" tools:targetApi="lollipop">@color/colorControlActivated</item>
        <item name="android:colorControlHighlight" tools:targetApi="lollipop">@color/colorControlHighlight</item>
        <item name="android:listSelector">@drawable/listview_item_selector</item>
        <!-- Support library compatibility -->
        <item name="actionBarStyle">@style/Theme.AppCompat.DayNight.DarkActionBar</item>
        <item name="colorAccent">@color/appAccentColor</item>
        <item name="colorControlActivated">@color/colorControlActivated</item>
        <item name="colorControlHighlight">@color/colorControlHighlight</item>
    </style>

    <!-- ActionBar styles -->
    <style name="QDVActivityThemeDef"
        parent="@style/Theme.AppCompat.DayNight">
<!--        <item name="android:background">@color/</item>-->
<!--        &lt;!&ndash; Support library compatibility &ndash;&gt;-->
<!--        <item name="background">@color/appAccentColor</item>-->
    </style>

    <style name="QDVActivityTheme.Launcher">
        <item name="android:windowBackground">@drawable/launch_screen</item>
        <item name="colorPrimaryDark">@android:color/white</item>
    </style>
</resources>
